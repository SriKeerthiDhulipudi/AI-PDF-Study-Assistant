# AI-Powered PDF Question Answering System - Environment Configuration
# Copy this file to .env and fill in your preferred API keys.

# Google Gemini API Key (get from https://aistudio.google.com/)
GOOGLE_API_KEY=

# Groq API Key (get from https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/)
OPENAI_API_KEY=
